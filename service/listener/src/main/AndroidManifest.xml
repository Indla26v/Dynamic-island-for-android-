<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only for the "Send test notification" button. Island asks for no INTERNET permission. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Optional: contact photos for callers and chat senders that arrive without one. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <application>
        <service
            android:name=".IslandNotificationListener"
            android:exported="true"
            android:label="@string/listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
            <!-- Ongoing (calls, progress) and silent (downloads) are needed for live activities;
                 the engine decides what pops. -->
            <meta-data
                android:name="android.service.notification.default_filter_types"
                android:value="conversations|alerting|ongoing|silent" />
        </service>

        <receiver
            android:name=".selftest.TestNotificationReceiver"
            android:exported="false" />
    </application>
</manifest>
